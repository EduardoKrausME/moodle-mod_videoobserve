{{!
    @template mod_videoobserve/view

    Example context (json):
    {
        Aqui tem que criar o context em inglês
    }
}}
<div class="videoobserve" id="videoobserve-app" data-cmid="{{cmid}}">
    <div class="d-flex flex-wrap justify-content-between align-items-start gap-2 mb-3">
        <div>
            <h2>{{name}}</h2>
            {{#hasintro}}
                <div class="videoobserve-intro">{{{intro}}}</div>{{/hasintro}}
        </div>
        <div class="btn-group flex-wrap" role="group" aria-label="{{#str}}actions{{/str}}">
            {{#canmanage}}<a class="btn btn-secondary" href="{{{manageurl}}}">{{#str}}
                manageobservationsheet, videoobserve{{/str}}</a>{{/canmanage}}
            {{#canreference}}<a class="btn btn-secondary" href="{{{referenceurl}}}">{{#str}}
                managereference, videoobserve{{/str}}</a>{{/canreference}}
            {{#canreport}}<a class="btn btn-secondary" href="{{{reporturl}}}">{{#str}}
                aggregatereport, videoobserve{{/str}}</a>{{/canreport}}
        </div>
    </div>

    <div class="videoobserve-layout">
        <section class="videoobserve-player-column" aria-label="{{#str}}player, videoobserve{{/str}}">
            <div class="videoobserve-player" data-region="player"></div>
            <div class="videoobserve-timeline mt-2" data-region="timeline"
                 aria-label="{{#str}}observationtimeline, videoobserve{{/str}}"></div>
            {{^isreference}}
                <div class="mt-3">
                    <div class="d-flex justify-content-between">
                        <strong>{{#str}}watchedpercent, videoobserve{{/str}}</strong>
                        <span data-region="percentlabel">{{percent}}%</span>
                    </div>
                    <div class="progress" role="progressbar" aria-valuemin="0" aria-valuemax="100"
                         aria-valuenow="{{percent}}">
                        <div class="progress-bar" data-region="progressbar" style="width: {{percent}}%"></div>
                    </div>
                </div>
            {{/isreference}}
        </section>

        <section class="videoobserve-sheet" aria-label="{{#str}}observationsheet, videoobserve{{/str}}">
            <div class="d-flex justify-content-between align-items-center mb-2">
                <h3 class="h5 mb-0">{{#str}}observationsheet, videoobserve{{/str}}</h3>
                <span class="badge bg-secondary"><span data-region="totalcount">{{totalcount}}</span> {{#str}}
                    markings, videoobserve{{/str}}</span>
            </div>
            {{^hasevents}}
                <div class="alert alert-info">{{#str}}noevents, videoobserve{{/str}}</div>
            {{/hasevents}}
            {{#events}}
                <article class="card mb-3 videoobserve-event" data-eventid="{{id}}">
                    <div class="card-body">
                        <div class="d-flex justify-content-between gap-2">
                            <div>
                                <h4 class="h6 mb-1">{{name}}{{#required}}<span class="text-danger"
                                                                               aria-label="{{#str}}required{{/str}}">*</span>{{/required}}
                                </h4>
                                {{#hasdescription}}
                                    <div class="small text-muted mb-2">{{description}}</div>{{/hasdescription}}
                            </div>
                            <span class="badge bg-light text-dark"><span
                                    data-region="eventcount">{{count}}</span></span>
                        </div>
                        {{#allowcomments}}
                            <label class="form-label small" for="videoobserve-note-{{id}}">{{#str}}
                                observationnote, videoobserve{{/str}}</label>
                            <textarea class="form-control form-control-sm mb-2" id="videoobserve-note-{{id}}" rows="2"
                                      data-region="note"></textarea>
                        {{/allowcomments}}
                        <div class="d-flex flex-wrap gap-2">
                            <button type="button" class="btn btn-primary btn-sm" data-action="mark"
                                    data-eventid="{{id}}">{{#str}}marknow, videoobserve{{/str}}</button>
                            {{#allowintervals}}
                                <button type="button" class="btn btn-outline-secondary btn-sm" data-action="interval"
                                        data-eventid="{{id}}">{{#str}}startinterval, videoobserve{{/str}}</button>
                            {{/allowintervals}}
                        </div>
                        <ul class="list-group list-group-flush mt-3" data-region="occurrences" data-eventid="{{id}}">
                            {{#occurrences}}
                                <li class="list-group-item px-0 py-2" data-occurrence-id="{{id}}"
                                    data-eventid="{{eventtypeid}}" data-start="{{starttime}}" data-end="{{endtime}}">
                                    <div class="d-flex justify-content-between align-items-start gap-2">
                                        <div>
                                            <button type="button" class="btn btn-link btn-sm p-0 fw-bold"
                                                    data-action="seek" data-time="{{starttime}}">{{timecode}}</button>
                                            {{#hasnote}}
                                                <div class="small mt-1"
                                                     data-region="savednote">{{{note}}}</div>{{/hasnote}}
                                        </div>
                                        <button type="button" class="btn btn-link btn-sm text-danger"
                                                data-action="delete" data-id="{{id}}">{{#str}}delete{{/str}}</button>
                                    </div>
                                </li>
                            {{/occurrences}}
                        </ul>
                    </div>
                </article>
            {{/events}}
        </section>
    </div>

    {{^isreference}}
        <section class="mt-4" aria-label="{{#str}}finalsheet, videoobserve{{/str}}">
            <h3>{{#str}}finalsheet, videoobserve{{/str}}</h3>
            <div class="table-responsive">
                <table class="table table-striped align-middle">
                    <thead>
                    <tr>
                        <th>{{#str}}event, videoobserve{{/str}}</th>
                        <th>{{#str}}quantity, videoobserve{{/str}}</th>
                        <th>{{#str}}identifiedmoments, videoobserve{{/str}}</th>
                        <th>{{#str}}observations, videoobserve{{/str}}</th>
                    </tr>
                    </thead>
                    <tbody data-region="summarybody">
                    {{#events}}
                        <tr data-summary-eventid="{{id}}">
                            <th scope="row">{{name}}</th>
                            <td data-summary="count">{{count}}</td>
                            <td data-summary="moments">
                                {{#occurrences}}
                                    <button type="button" class="btn btn-link btn-sm p-0 me-2" data-action="seek"
                                            data-time="{{starttime}}">{{timecode}}</button>{{/occurrences}}
                            </td>
                            <td data-summary="notes">
                                {{#occurrences}}{{#hasnote}}
                                    <div>{{{note}}}</div>{{/hasnote}}{{/occurrences}}
                            </td>
                        </tr>
                    {{/events}}
                    </tbody>
                </table>
            </div>
        </section>
    {{/isreference}}

    {{#showreference}}
        <section class="mt-4">
            <h3>{{#str}}referenceanswer, videoobserve{{/str}}</h3>
            {{^hasreferences}}
                <div class="alert alert-light">{{#str}}noreference, videoobserve{{/str}}</div>{{/hasreferences}}
            {{#hasreferences}}
                <p class="small text-muted">{{referencevisiblelabel}}</p>
                <ul class="list-group">
                    {{#references}}
                        <li class="list-group-item"><strong>{{eventname}}</strong> —
                            <button type="button" class="btn btn-link btn-sm p-0" data-action="seek"
                                    data-time="{{starttime}}">{{timecode}}</button>{{#hasnote}}
                                <div class="small" data-region="savednote">{{{note}}}</div>{{/hasnote}}</li>
                    {{/references}}
                </ul>
            {{/hasreferences}}
        </section>
    {{/showreference}}
</div>
